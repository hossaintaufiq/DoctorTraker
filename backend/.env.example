# ==============================================================================
# Doctor Tracker — Backend Environment Variables (.env)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI (Local or Atlas Replica Set)
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# JWT Authentication & Authorization
# Minimum 32-character high-entropy secret string for signing access tokens
JWT_SECRET=replace_with_a_secure_random_jwt_access_secret_min_32_chars
# Access token lifespan (e.g. 15m)
JWT_ACCESS_EXPIRES_IN=15m

# Dedicated secret for signing refresh tokens
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_min_32_chars
# Refresh token lifespan (e.g. 7d)
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated, without trailing slashes)
CORS_ORIGIN=http://localhost:3000

# Security & Cookie Flags
# Set to true in production (HTTPS required for SameSite=None / Secure cookies)
COOKIE_SECURE=false
# SameSite cookie setting: lax, strict, or none
COOKIE_SAME_SITE=lax

# Administrative System Controls
# Explicit safeguard flag required to allow POST /api/system/reset-database
# MUST be false in production
ALLOW_DB_RESET=false
