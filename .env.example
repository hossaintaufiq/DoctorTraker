# ==============================================================================
# Doctor Tracker — Healthcare Management System (Monorepo Root .env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker
JWT_SECRET=replace_with_a_secure_random_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
ALLOW_DB_RESET=false
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
